#!/bin/bash
# omacast CLI, KDE Plasma edition.
#
# omacast runs as its own Quickshell instance (qs -p <checkout>/shell.qml),
# started by a systemd user service. Every command below talks to that
# instance over Quickshell's IPC.

set -uo pipefail

IPC_TARGET="omacast"
SERVICE="omacast.service"
DESKTOP_ID="omacast.desktop"

self=$(readlink -f "${BASH_SOURCE[0]}")
repo=$(cd "$(dirname "$self")/.." && pwd -P)
entry="$repo/shell.qml"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
unit_file="$config_home/systemd/user/$SERVICE"
desktop_file="$data_home/applications/$DESKTOP_ID"
krunner_backup="$config_home/omacast/krunner-shortcut"
cli_link="$HOME/.local/bin/omacast"

usage() {
  cat <<USAGE
Usage: omacast <command> [args]

Launcher
  toggle                 Show or hide the launcher
  show | hide            Show or hide it
  run <commandId>        Open a command directly, e.g. omacast run omarchy:system.lock
  call <method> [json]   Call a backend method, e.g. omacast call system.info

Setup
  install                Start omacast with your session (systemd user service)
                         and link this CLI into ~/.local/bin
  setup kde [--key K] [--yes]
                         Bind a global shortcut (default Alt+Space). Takes
                         Alt+Space from KRunner, which keeps Alt+F2.
  uninstall [--yes]      Remove the service and the shortcut, give KRunner
                         its shortcut back
  build-search           Build the optional flea-search helper (needs Rust/cargo)
  doctor                 Check that the pieces are in place

Development
  restart                Restart the running instance (picks up QML edits)
  log                    Follow the instance's log
USAGE
}

die() { echo "omacast: $*" >&2; exit 1; }
interactive() { [[ -t 0 && -t 1 ]]; }

qs_bin() { command -v qs || command -v quickshell; }

need_qs() { qs_bin >/dev/null || die "Quickshell not found; install it first (Arch/CachyOS: pacman -S quickshell)"; }

ipc() { "$(qs_bin)" ipc -p "$entry" call "$IPC_TARGET" "$@"; }

running() { [[ $(ipc ping 2>/dev/null) == ok ]]; }

# confirm <prompt> <assume-yes>
confirm() {
  (( $2 )) && return 0
  interactive || die "refusing to change your settings without confirmation; pass --yes"
  local answer
  read -r -p "$1 [y/N] " answer
  [[ $answer == [yY]* ]]
}

link_cli() {
  mkdir -p "$HOME/.local/bin"
  if [[ ! -e $cli_link || -L $cli_link ]]; then
    ln -sfn "$self" "$cli_link"
    echo "linked $cli_link"
  else
    echo "left $cli_link alone; it is not a symlink"
  fi
}

# systemd unit values: % is a specifier and paths are quoted.
unit_quote() { local v=${1//%/%%}; printf '"%s"' "${v//\"/\\\"}"; }

cmd_install() {
  need_qs
  [[ -f $entry ]] || die "shell.qml missing at $repo"
  if command -v cargo >/dev/null; then
    "$repo/bin/build-search" || die "search helper build failed; nothing was installed"
  else
    echo "Rust not found; skipping the helper build (the built-in matcher works without it)"
  fi
  link_cli

  mkdir -p "$(dirname "$unit_file")"
  cat >"$unit_file" <<UNIT
# Written by \`omacast install\`; rerunning install overwrites it.
[Unit]
Description=omacast launcher (Quickshell)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=$(unit_quote "$(qs_bin)") -p $(unit_quote "$entry")
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
UNIT
  echo "wrote $unit_file"
  systemctl --user daemon-reload
  systemctl --user enable --now "$SERVICE" >/dev/null 2>&1 || die "could not start $SERVICE; see: journalctl --user -u $SERVICE"
  # A unit that was already running keeps the old checkout until restarted.
  systemctl --user restart "$SERVICE"

  local i
  for i in $(seq 1 100); do
    if running; then
      echo "omacast is running"
      [[ -f $desktop_file ]] || echo "bind a shortcut with: omacast setup kde"
      return 0
    fi
    sleep 0.1
  done
  die "omacast did not answer; see: journalctl --user -u $SERVICE -e"
}

# ------------------------------------------------------------ shortcuts
#
# kglobalaccel (inside KWin on Plasma 6) speaks QKeySequence over D-Bus as
# a struct of four ints, one per chord; a set of them is a(ai). gdbus can
# build that, dbus-send and qdbus can't.

KGA=(--session --dest org.kde.kglobalaccel --object-path /kglobalaccel)
KRUNNER_ID="['org.kde.krunner.desktop', '_launch', 'KRunner', '']"
OMACAST_ID="['$DESKTOP_ID', '_launch', 'omacast', '']"

kga() { gdbus call "${KGA[@]}" --method "org.kde.KGlobalAccel.$1" "${@:2}"; }

# "Alt+Space" -> Qt key code (modifiers | key). Supports Ctrl/Alt/Shift/Meta
# with Space, Return, Tab, a letter, a digit or F1–F12.
key_code() {
  local spec=$1 code=0 part key
  IFS=+ read -ra parts <<<"$spec"
  key=${parts[-1]}
  for part in "${parts[@]:0:${#parts[@]}-1}"; do
    case ${part,,} in
      shift) (( code |= 0x02000000 )) ;;
      ctrl|control) (( code |= 0x04000000 )) ;;
      alt) (( code |= 0x08000000 )) ;;
      meta|super|win) (( code |= 0x10000000 )) ;;
      *) return 1 ;;
    esac
  done
  case ${key,,} in
    space) (( code |= 0x20 )) ;;
    return|enter) (( code |= 0x01000004 )) ;;
    tab) (( code |= 0x01000001 )) ;;
    f[1-9]|f1[0-2]) (( code |= 0x01000030 + ${key:1} - 1 )) ;;
    [a-z]) (( code |= $(printf '%d' "'${key^^}") )) ;;
    [0-9]) (( code |= $(printf '%d' "'$key") )) ;;
    *) return 1 ;;
  esac
  (( code & 0x01FFFFFF )) || return 1
  echo "$code"
}

# The first int of each key sequence in a gdbus a(ai) reply.
key_codes() { grep -oE '\(\[[0-9]+' | tr -d '([' ; }

keys_variant() {
  local out="" code
  for code in "$@"; do out+="${out:+, }([$code, 0, 0, 0],)"; done
  if [[ -n $out ]]; then echo "[$out]"; else echo "@a(ai) []"; fi
}

# Who owns a key: prints the component id (e.g. org.kde.krunner.desktop) or nothing.
key_owner() {
  kga actionList "([$1, 0, 0, 0],)" 2>/dev/null | grep -oE "^\(\['[^']*'" | cut -c4- | tr -d "'"
}

cmd_setup_kde() {
  local assume_yes=0 key="Alt+Space"
  while (( $# )); do
    case $1 in
      --yes|-y) assume_yes=1 ;;
      --key) key=${2:-}; shift ;;
      *) die "usage: omacast setup kde [--key Alt+Space] [--yes]" ;;
    esac
    shift
  done
  command -v gdbus >/dev/null || die "gdbus not found (glib2); set the shortcut by hand: System Settings › Keyboard › Shortcuts › Add New › Command: $cli_link toggle"
  kga allMainComponents >/dev/null 2>&1 || die "kglobalaccel is not reachable on the session bus; is this a Plasma session?"
  local code
  code=$(key_code "$key") || die "can't parse key '$key'; use e.g. Alt+Space, Meta+Space, Ctrl+Alt+K"

  local owner plan=() i
  owner=$(key_owner "$code")
  if [[ -n $owner && $owner != "$DESKTOP_ID" && $owner != org.kde.krunner.desktop ]]; then
    die "$key is already used by $owner; free it in System Settings › Keyboard › Shortcuts, or pick another with --key"
  fi
  [[ $owner == org.kde.krunner.desktop ]] && plan+=("remove $key from KRunner (it keeps its other shortcuts, e.g. Alt+F2)")
  plan+=("write $desktop_file, bound to $key")

  echo "omacast setup kde will:"
  printf '  - %s\n' "${plan[@]}"
  confirm "Make these changes?" "$assume_yes" || die "nothing changed"

  if [[ $owner == org.kde.krunner.desktop ]]; then
    local current rest=() c
    current=$(kga shortcutKeys "$KRUNNER_ID")
    mkdir -p "$(dirname "$krunner_backup")"
    [[ -f $krunner_backup ]] || printf '%s\n' "$current" | key_codes >"$krunner_backup"
    while read -r c; do [[ -n $c && $c != "$code" ]] && rest+=("$c"); done < <(printf '%s\n' "$current" | key_codes)
    kga setForeignShortcutKeys "$KRUNNER_ID" "$(keys_variant "${rest[@]}")" >/dev/null || die "could not change KRunner's shortcut"
    echo "removed $key from KRunner (old keys saved in $krunner_backup)"
  fi

  # kglobalaccel keeps the service it loaded and only re-reads a desktop
  # file when the component is created. When the entry already exists (say
  # the checkout moved), drop it first so the new Exec line is picked up.
  if [[ -f $desktop_file ]] && command -v kbuildsycoca6 >/dev/null; then
    rm "$desktop_file"
    kbuildsycoca6 >/dev/null 2>&1
    for i in $(seq 1 30); do
      kga shortcutKeys "$OMACAST_ID" 2>/dev/null | key_codes | grep -q . || break
      sleep 0.1
    done
  fi

  mkdir -p "$(dirname "$desktop_file")"
  cat >"$desktop_file" <<DESKTOP
[Desktop Entry]
# Written by \`omacast setup kde\`. The shortcut lives in System Settings ›
# Keyboard › Shortcuts › omacast; X-KDE-Shortcuts is only its default.
Type=Application
Name=omacast
Comment=Toggle the omacast launcher
Icon=system-search
Exec="$(qs_bin)" ipc -p "$entry" call $IPC_TARGET toggle
NoDisplay=true
X-KDE-Shortcuts=$key
DESKTOP
  echo "wrote $desktop_file"

  # kglobalaccel picks up new X-KDE-Shortcuts entries when ksycoca changes.
  command -v kbuildsycoca6 >/dev/null && kbuildsycoca6 >/dev/null 2>&1
  for i in $(seq 1 50); do
    if kga shortcutKeys "$OMACAST_ID" 2>/dev/null | key_codes | grep -qx "$code"; then
      echo "$key toggles omacast"
      return 0
    fi
    # Registered already but with an older default: set it explicitly.
    kga shortcutKeys "$OMACAST_ID" >/dev/null 2>&1 && kga setForeignShortcutKeys "$OMACAST_ID" "$(keys_variant "$code")" >/dev/null 2>&1
    sleep 0.1
  done
  echo "the shortcut is written but KDE hasn't picked it up yet; it works after the next login,"
  echo "or set it now in System Settings › Keyboard › Shortcuts › omacast"
}

restore_krunner() {
  [[ -f $krunner_backup ]] || return 0
  command -v gdbus >/dev/null || { echo "gdbus missing; give KRunner its shortcut back in System Settings"; return 0; }
  local codes=()
  mapfile -t codes < <(grep -E '^[0-9]+$' "$krunner_backup")
  if kga setForeignShortcutKeys "$KRUNNER_ID" "$(keys_variant "${codes[@]}")" >/dev/null 2>&1; then
    rm -f "$krunner_backup"
    echo "gave KRunner its shortcuts back"
  else
    echo "could not restore KRunner's shortcut; the old keys are in $krunner_backup"
  fi
}

cmd_uninstall() {
  local assume_yes=0
  [[ ${1:-} == --yes || ${1:-} == -y ]] && assume_yes=1
  confirm "Stop omacast, remove its service, shortcut and CLI link?" "$assume_yes" || die "nothing changed"
  if [[ -f $desktop_file ]]; then
    rm "$desktop_file" && echo "removed $desktop_file"
    command -v kbuildsycoca6 >/dev/null && kbuildsycoca6 >/dev/null 2>&1
    sleep 0.5   # let kglobalaccel drop omacast's key before KRunner takes it
  fi
  restore_krunner
  if [[ -f $unit_file ]]; then
    systemctl --user disable --now "$SERVICE" >/dev/null 2>&1
    rm "$unit_file" && echo "removed $unit_file"
    systemctl --user daemon-reload
  fi
  if [[ -L $cli_link && $(readlink -f "$cli_link") == "$self" ]]; then
    rm "$cli_link" && echo "removed $cli_link"
  fi
  echo "your history and settings stay in ${XDG_DATA_HOME:-~/.local/share}/omacast and $config_home/omacast"
}

cmd_doctor() {
  local bad=0
  check() {
    local label=$1; shift
    if "$@" >/dev/null 2>&1; then printf '  ok    %s\n' "$label"; else printf '  FAIL  %s\n' "$label"; bad=1; fi
  }
  info() { printf '  info  %s\n' "$1"; }
  echo "omacast doctor"
  check "Quickshell is installed" qs_bin
  check "Wayland session" test -n "${WAYLAND_DISPLAY:-}"
  if [[ ${XDG_CURRENT_DESKTOP:-} == *KDE* ]]; then printf '  ok    Plasma session\n'; else info "not a Plasma session (XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-unset}); KDE actions won't work"; fi
  check "service $SERVICE is running" systemctl --user is-active "$SERVICE"
  check "omacast answers IPC" running
  check "backend answers system.healthPing" bash -c "$(printf '%q ' "$self") call system.healthPing '{}' | grep -q '\"ok\":true'"
  check "wl-copy is installed (copy answers)" command -v wl-copy
  check "kstart is installed (launch apps)" command -v kstart
  check "a Nerd Font provides the UI glyphs" bash -c "fc-list : family | grep -qi 'nerd font'"
  if command -v kdotool >/dev/null; then printf '  ok    kdotool is installed (focus open windows)\n'
  else info "no kdotool: opening an app always starts a new instance (AUR: kdotool)"; fi
  if command -v ydotool >/dev/null || command -v dotool >/dev/null; then printf '  ok    ydotool/dotool installed (paste answers)\n'
  else info "no ydotool/dotool: \"Paste Answer\" only copies"; fi
  if [[ -x $repo/bin/omacast-search ]]; then printf '  ok    flea-search helper is built\n'
  else info "no flea-search helper; using the built-in matcher (build it with: omacast build-search)"; fi
  if [[ -f $desktop_file ]]; then
    local key
    key=$(sed -n 's/^X-KDE-Shortcuts=//p' "$desktop_file")
    if command -v gdbus >/dev/null && code=$(key_code "$key") && kga shortcutKeys "$OMACAST_ID" 2>/dev/null | key_codes | grep -qx "$code"; then
      printf '  ok    shortcut %s is active\n' "$key"
    else
      info "shortcut file exists but $key isn't confirmed active; check System Settings › Keyboard › Shortcuts › omacast"
    fi
  else
    info "no shortcut yet; run: omacast setup kde"
  fi
  return $bad
}

case "${1:-}" in
  toggle|show|hide) need_qs; ipc "$1" >/dev/null ;;
  run) need_qs; [[ -n ${2:-} ]] || die "usage: omacast run <commandId>"; ipc run "$2" ;;
  call) need_qs; [[ -n ${2:-} ]] || die "usage: omacast call <method> [json]"; ipc call "$2" "${3:-}" ;;
  ping) need_qs; ipc ping ;;
  build-search) "$repo/bin/build-search" ;;
  install) cmd_install ;;
  uninstall) cmd_uninstall "${2:-}" ;;
  setup)
    case "${2:-}" in
      kde) shift 2; cmd_setup_kde "$@" ;;
      *) die "usage: omacast setup kde [--key Alt+Space] [--yes]" ;;
    esac
    ;;
  restart) systemctl --user restart "$SERVICE" ;;
  log) journalctl --user -u "$SERVICE" -f ;;
  doctor) cmd_doctor ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 1 ;;
esac
